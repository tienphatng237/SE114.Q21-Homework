<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@android:color/transparent"
        app:title="@string/home"
        app:subtitle="@string/home_subtitle"
        app:subtitleTextColor="@color/text_secondary"
        app:titleTextColor="@color/text_primary" />

    <HorizontalScrollView
        android:id="@+id/home_options_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_bottom_nav"
        android:fillViewport="true"
        android:scrollbars="none"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_option_sort_oldest"
                style="@style/SketchMenuButton"
                android:layout_width="84dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/menu_sort_oldest" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_option_sort_newest"
                style="@style/SketchMenuButton"
                android:layout_width="84dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/menu_sort_newest" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_option_sort_author"
                style="@style/SketchMenuButton"
                android:layout_width="84dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/menu_sort_author" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_option_hidden"
                style="@style/SketchMenuButton"
                android:layout_width="84dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/menu_hidden" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_option_api_sync"
                style="@style/SketchMenuButton"
                android:layout_width="72dp"
                android:layout_height="42dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/menu_api_sync" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToOutline="true"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:elevation="0dp"
        app:cardBackgroundColor="@color/panel_background"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline_soft"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_post_input"
                    style="@style/SketchInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_post_input"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_post"
                    style="@style/SketchPrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/post" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_friend_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_field"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/text_friend_suggestions_title"
                    style="@style/SketchLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/friend_suggestions_title" />

                <TextView
                    android:id="@+id/text_friend_suggestions_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/friend_suggestions_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_sync_contacts"
                    style="@style/SketchMenuButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/friend_suggestions_sync" />

                <TextView
                    android:id="@+id/text_friend_suggestions_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/friend_suggestions_permission_required"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/list_friend_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <ListView
                android:id="@+id/list_posts"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="14dp"
                android:layoutAnimation="@anim/layout_posts"
                android:listSelector="@android:color/transparent"
                android:overScrollMode="never"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
